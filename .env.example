# Copy to .env. Never commit .env.
HOST=127.0.0.1
PORT=4801

# Session (HS256 JWT in an HttpOnly cookie). Min 32 chars: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=12

# Directory. The real deployment talks to the company's LDAP/AD; this repo ships a fake
# directory with the same client interface, backed by a JSON file.
DIRECTORY_FILE=fixtures/directory.demo.json
DIRECTORY_BASE_DN=ou=People,dc=mapcidade,dc=example
DIRECTORY_BIND_DN=cn=svc-training,ou=Services,dc=mapcidade,dc=example
DIRECTORY_BIND_PASSWORD=service-demo-password

# Progress database (node:sqlite file).
DATABASE_FILE=data/training.db

# Fixed managers (can see /management). Others are added from the management screen.
MANAGERS=morgan.hale
